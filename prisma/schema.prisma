generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model student_logs {
  id         Int       @id @default(autoincrement())
  student_id Int
  action     String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  student    students  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_student_logs_students")
}

model students {
  id           Int            @id @default(autoincrement())
  name         String
  age          Int
  course_id    Int?
  courses      courses?       @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_students_courses")
  student_logs student_logs[]

  @@index([course_id])
}

model courses {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(100)
  students students[]
}

model users {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role String @default("user")
  created_at DateTime @default(now())
}
