generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model student_logs {
  id         Int       @id @default(autoincrement())
  student_id Int
  action     String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model students {
  id     Int    @id @default(autoincrement())
  name   String
  age    Int
  course String
}
