# ==============================================================================
# Student API - Environment Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# [REQUIRED] Application port (defaults to 3000 if not specified)
PORT=3000

# [REQUIRED] Application environment: "development", "production", or "test"
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# [REQUIRED] Full PostgreSQL connection URL used by Prisma ORM and migrations.
# Local development format:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Student?schema=public"

# Managed PostgreSQL example (e.g. Supabase / AWS RDS with SSL):
# DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Caching & Refresh Token Store)
# ------------------------------------------------------------------------------
# [REQUIRED] Redis connection URL.
# Local development format:
REDIS_URL="redis://localhost:6379"

# Managed cloud Redis example (with TLS / auth):
# REDIS_URL="rediss://default:your_redis_password@your-redis-host:6379"

# ------------------------------------------------------------------------------
# 4. Authentication Secrets (JWT)
# ------------------------------------------------------------------------------
# [REQUIRED] Secret keys used for signing and verifying JWT tokens.
# In production, generate strong random strings (e.g. openssl rand -base64 32).
JWT_SECRET="your_jwt_access_token_secret_min_32_characters"
JWT_REFRESH_SECRET="your_jwt_refresh_token_secret_min_32_characters"

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (OPTIONAL)
# ------------------------------------------------------------------------------
# [OPTIONAL] Required only if Google OAuth login (/users/auth/google) is used.
# If omitted, the core Student API boots normally with local email/password auth.
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
# Local development callback:
GOOGLE_CALLBACK_URL="http://localhost:3000/users/auth/google/callback"
# Production callback example:
# GOOGLE_CALLBACK_URL="https://api.yourdomain.com/users/auth/google/callback"

# ------------------------------------------------------------------------------
# 6. Swagger UI Auto-Authentication (DEVELOPMENT ONLY)
# ------------------------------------------------------------------------------
# [OPTIONAL / DEV-ONLY] Credentials to automatically pre-authorize Swagger UI.
# Only executed when NODE_ENV=development. Completely ignored in production.
SWAGGER_AUTO_AUTH_EMAIL="admin@example.com"
SWAGGER_AUTO_AUTH_PASSWORD="your_dev_password"

# ------------------------------------------------------------------------------
# 7. Automated Testing Configuration (TEST-ONLY)
# ------------------------------------------------------------------------------
# [TEST-ONLY] Used by Vitest test runner when NODE_ENV=test (npm test).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/student_api_test"
REDIS_URL_TEST="redis://localhost:6379/1"
